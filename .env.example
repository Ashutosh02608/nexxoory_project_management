DATABASE_URL=postgresql://your_db_connection_string
# Keep certificate verification enabled unless your database provider explicitly requires otherwise.
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
FRONTEND_URL=https://your-production-domain.example
ALLOWED_ORIGINS=https://your-production-domain.example
# Set only when authentication must span subdomains, for example .example.com
COOKIE_DOMAIN=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
PASSWORD_RESET_EXPIRES_MINUTES=30

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Nexxoory PM" <no-reply@nexxoory.com>
