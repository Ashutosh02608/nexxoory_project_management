# Database Configuration
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/nexxoory?sslmode=require

# Direct URL for running migrations outside connection pooler (optional for Neon)
DIRECT_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/nexxoory?sslmode=require

# Application Environment
NODE_ENV=development
PORT=3000

# Authentication & JWT Secrets (Phase 3)
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars

# Pusher / Ably Realtime Credentials (Phase 4)
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=mt1

